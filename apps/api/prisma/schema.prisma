generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

enum BookingPurpose {
  PODCAST_RECORDING
  VIDEO_PODCAST
  PHOTOGRAPHY
  VIDEOGRAPHY
  MUSIC_VIDEO
  DANCE_VIDEO
  LIVE_STREAMING
  COMMUNITY_EVENT
  CORPORATE_MEETING
  WORKSHOP
  OTHER
}

model Admin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id            String         @id @default(uuid())
  bookingId     String         @unique
  customerName  String
  phone         String
  email         String
  company       String?
  purpose       BookingPurpose
  bookingDate   DateTime       @db.Date
  startTime     String
  endTime       String
  durationHours Int
  peopleCount   Int
  notes         String?
  status        BookingStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([bookingDate])
  @@index([status])
  @@index([bookingDate, status])
  @@index([purpose])
  @@index([customerName])
  @@index([phone])
  @@index([bookingId])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  startTime String
  endTime   String
  reason    String?
  isFullDay Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model BusinessSetting {
  id              String   @id @default(uuid())
  studioName      String
  ownerName       String
  phone           String
  whatsappNumber  String
  email           String
  address         String
  googleMapsUrl   String?
  instagram       String?
  youtube         String?
  facebook        String?
  openingTime     String
  closingTime     String
  hourlyPrice     Float
  minBookingHours Int      @default(2)
  maxBookingHours Int      @default(12)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
